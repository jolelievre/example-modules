{% trans_default_domain 'Module.Dashexample.Admin' %}

<div class="card dashexample-card">
  <div class="card-header">
    <h3 class="card-header-title">
      <i class="material-icons">view_stream</i>
      {{ 'Full-width bottom zone'|trans }}
    </h3>
  </div>
  <div class="card-body">
    <p class="mb-0">{{ 'This full-width block is rendered by the dashexample module through the displayAdminDashboardBottom hook.'|trans }}</p>
  </div>
  <div class="card-footer text-muted">
    {{ 'Selected range: %from% → %to%'|trans({'%from%': dateFrom, '%to%': dateTo}) }}
  </div>
</div>
